{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/maquina-de-cartao", "destination": "/maquina-de-cartao.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/orcamento", "destination": "/orcamento.html" },
    { "source": "/stark", "destination": "/stark.html" }
  ]
}
